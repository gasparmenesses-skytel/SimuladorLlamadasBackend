# Copiar a .env y completar. .env nunca se versiona ni se copia a la imagen Docker.
# Hace falta al menos una API key; cada motor se habilita si tiene la suya.

# --- OpenAI GPT-Live (full-duplex, WebRTC). Key de https://platform.openai.com/api-keys (sk-proj-...)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-live-1
OPENAI_VOICE=marin

# --- Google Gemini Live (por turnos, WebSocket). Key gratis de https://aistudio.google.com/apikey (empieza con AQ.)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-live
# Voces femeninas para probar: Gacrux (madura), Kore, Sulafat, Aoede, Leda.
GEMINI_VOICE=Gacrux

# Motor por defecto en el cliente de prueba: openai | gemini (vacío = el primero con key).
VOICE_ENGINE=

# Duración máxima de una llamada en minutos (Gemini: vida del token efímero).
MAX_CALL_MINUTES=15

# Cliente de prueba en http://localhost:8000/dev (desactivar en producción).
ENABLE_DEV_CLIENT=true

# Orígenes del futuro frontend React, separados por coma (ej: http://localhost:5173).
CORS_ORIGINS=

LOG_LEVEL=INFO
